      "position": {
        "x": 1152.303981279067,
        "y": -214.10669803545287
      },
      "data": {
        "title": "XML extraction",
        "body": "There is a lot of text here, much of which is TEI padder; useful for computational linguistics, but here we are just interested in the prose part, so we can extract the 'body' and not wory about filling up our LLM context with irrelevant noise.",
        "handleUnlocked": true
