    },
    {
      "id": "comment-59",
      "type": "comment",
      "position": {
        "x": -2.638405812650177,
        "y": -115.37181978905254
      },
      "data": {
        "title": "Linguistic data branch",
        "body": "On this branch we look at two XML files of authors arguing about the provenance of Stonehenge. What is the summary of their different positions? How do they make their arguments?"
      },
      "width": 759,
      "height": 233,
      "style": {
        "width": 220,
        "height": 120
      }
    },
    {
      "id": "comment-61",
      "type": "comment",
      "position": {
        "x": 1.756990025604182,
        "y": 754.422176809184
      },
      "data": {
        "title": "Archaeological data branch",
        "body": "On this branch we are looking at a more modern aspect to the argument - papers from 2009, 2012 and 2021. \nI'm a lay person in this domain - can an LLM help to render the scientific arguments more comprehensible to?"
      },
      "width": 898,
      "height": 237,
      "style": {
        "width": 220,
        "height": 120
      }
    },
    {
