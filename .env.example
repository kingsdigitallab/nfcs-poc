# KCL API key — injected at Vite build time via --build-arg VITE_KCL_API_KEY
VITE_KCL_API_KEY=sk-your-key-here

# Cloudflare named tunnel token.
# Obtain from: Zero Trust dashboard → Networks → Tunnels → your tunnel → token.
# Used only when starting with: docker compose --profile tunnel up
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: override the Ollama host (defaults to http://ollama:11434 in Docker)
# OLLAMA_HOST=http://localhost:11434
