# KCL API key — injected at Vite build time via --build-arg VITE_KCL_API_KEY
VITE_KCL_API_KEY=sk-your-key-here
VITE_EUROPEANA_API_KEY=your-europeana-key-here

# Cloudflare named tunnel token.
# Obtain from: Zero Trust dashboard → Networks → Tunnels → your tunnel → token.
# Used only when starting with: docker compose --profile tunnel up
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: override the Ollama host (defaults to http://ollama:11434 in Docker)
# OLLAMA_HOST=http://localhost:11434

# /url-proxy allowlist — comma-separated host suffixes the server may fetch on
# behalf of browser clients (e.g. "ac.uk,europeana.eu,wikipedia.org").
# Unset in development = any public host; unset in production = all denied.
# Private, loopback and link-local addresses are always refused.
URL_PROXY_ALLOWLIST=
